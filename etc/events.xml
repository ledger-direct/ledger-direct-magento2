<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">

    <event name="payment_method_is_active">
        <observer name="toggle_payment_method" instance="Hardcastle\LedgerDirect\Observer\PaymentMethodIsActive" />
        <!-- A method whose asset the receiving account cannot take (no trustline, …) is not offered. -->
        <observer name="ledger_direct_receiving_account" instance="Hardcastle\LedgerDirect\Observer\ReceivingAccountAvailability" />
    </event>
    <event name="payment_method_assign_data">
        <observer name="ledger_direct_data_assign" instance="Hardcastle\LedgerDirect\Observer\DataAssign" />
    </event>
    <event name="checkout_submit_all_after">
        <observer name="ledger_direct_send_pending_payment_email" instance="Hardcastle\LedgerDirect\Observer\SendPendingPaymentEmail" />
    </event>

</config>
