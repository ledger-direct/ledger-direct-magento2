<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Console Commands -->
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="XrplAccountLookup" xsi:type="object">Hardcastle\LedgerDirect\Commands\XrplAccountLookupCommand</item>
                <item name="XrplPriceLookup" xsi:type="object">Hardcastle\LedgerDirect\Commands\XrplPriceLookupCommand</item>
                <item name="XrplTransactionLookup" xsi:type="object">Hardcastle\LedgerDirect\Commands\XrplTransactionLookupCommand</item>
            </argument>
        </arguments>
    </type>

    <!-- Interface defaults -->
    <preference for="Hardcastle\LedgerDirect\Api\CryptoPriceServiceInterface" type="Hardcastle\LedgerDirect\Model\API\CryptoPriceService" />

    <preference for="Hardcastle\LedgerDirect\Api\XrpPaymentServiceInterface" type="Hardcastle\LedgerDirect\Model\Api\XrpPaymentService" />
    <preference for="Hardcastle\LedgerDirect\Api\Data\XrpPaymentInterface" type="Hardcastle\LedgerDirect\Model\XrpPayment" />

    <!--
        Ports: the platform side of hardcastle/ledger-direct-core's interfaces. Everything about
        what is owed (pricing, oracles, destination tags, sync/matching) lives in the core; this
        module only provides configuration and storage.
    -->
    <preference for="Hardcastle\LedgerDirect\Core\Port\ConfigProviderInterface" type="Hardcastle\LedgerDirect\Port\MagentoConfigProvider" />
    <preference for="Hardcastle\LedgerDirect\Core\Port\XrplTransactionRepositoryInterface" type="Hardcastle\LedgerDirect\Port\MagentoXrplTransactionRepository" />

    <!--
        Core services. Guzzle 7 already is a PSR-18 client and GuzzleHttp\Psr7\HttpFactory the
        matching PSR-17 factory, both shipped with Magento, so the core's HTTP dependencies are
        satisfied without an adapter package. They are wired per class rather than as global
        preferences for the PSR interfaces, so that no other extension's DI is affected.
        Rates are cached through a PSR-16 view of Magento's cache, which lets the core serve
        a slightly stale rate when every oracle is down instead of the payment method
        vanishing mid-checkout.
    -->
    <type name="Hardcastle\LedgerDirect\Core\Price\PriceService">
        <arguments>
            <argument name="httpClient" xsi:type="object">GuzzleHttp\Client</argument>
            <argument name="requestFactory" xsi:type="object">GuzzleHttp\Psr7\HttpFactory</argument>
            <argument name="logger" xsi:type="object">Psr\Log\LoggerInterface</argument>
            <argument name="rateCache" xsi:type="object">Hardcastle\LedgerDirect\Model\Cache\RateCache</argument>
        </arguments>
    </type>
    <type name="Hardcastle\LedgerDirect\Core\Xrpl\XrplClient">
        <arguments>
            <argument name="httpClient" xsi:type="object">GuzzleHttp\Client</argument>
            <argument name="requestFactory" xsi:type="object">GuzzleHttp\Psr7\HttpFactory</argument>
            <argument name="streamFactory" xsi:type="object">GuzzleHttp\Psr7\HttpFactory</argument>
        </arguments>
    </type>
    <type name="Hardcastle\LedgerDirect\Core\Xrpl\SyncService">
        <arguments>
            <argument name="logger" xsi:type="object">Psr\Log\LoggerInterface</argument>
        </arguments>
    </type>

    <!-- Payment method facades (Magento\Payment\Model\Method\Adapter) -->
    <virtualType name="Hardcastle\LedgerDirect\Model\PaymentMethod\XrpFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="string">xrp_payment</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Magento\Payment\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">Hardcastle\LedgerDirect\Gateway\Config\XrpValueHandlerPool</argument>
            <argument name="commandPool" xsi:type="object">Hardcastle\LedgerDirect\Gateway\Command\CommandPool</argument>
        </arguments>
    </virtualType>

    <virtualType name="Hardcastle\LedgerDirect\Model\PaymentMethod\XrplRlusdFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="string">xrpl_rlusd_payment</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Magento\Payment\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">Hardcastle\LedgerDirect\Gateway\Config\XrplRlusdValueHandlerPool</argument>
            <argument name="commandPool" xsi:type="object">Hardcastle\LedgerDirect\Gateway\Command\CommandPool</argument>
        </arguments>
    </virtualType>

    <virtualType name="Hardcastle\LedgerDirect\Model\PaymentMethod\XrplUsdcFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="string">xrpl_usdc_payment</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Magento\Payment\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">Hardcastle\LedgerDirect\Gateway\Config\XrplUsdcValueHandlerPool</argument>
            <argument name="commandPool" xsi:type="object">Hardcastle\LedgerDirect\Gateway\Command\CommandPool</argument>
        </arguments>
    </virtualType>

    <!-- Shared command pool: initialize is the only lifecycle hook this offline/redirect method needs -->
    <virtualType name="Hardcastle\LedgerDirect\Gateway\Command\CommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="initialize" xsi:type="string">Hardcastle\LedgerDirect\Gateway\Command\InitializeCommand</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Per-method config value resolution (each method reads its own payment/<code>/* config scope) -->
    <virtualType name="Hardcastle\LedgerDirect\Gateway\Config\XrpConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="string">xrp_payment</argument>
        </arguments>
    </virtualType>
    <virtualType name="Hardcastle\LedgerDirect\Gateway\Config\XrpConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">Hardcastle\LedgerDirect\Gateway\Config\XrpConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="Hardcastle\LedgerDirect\Gateway\Config\XrpValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">Hardcastle\LedgerDirect\Gateway\Config\XrpConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="Hardcastle\LedgerDirect\Gateway\Config\XrplRlusdConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="string">xrpl_rlusd_payment</argument>
        </arguments>
    </virtualType>
    <virtualType name="Hardcastle\LedgerDirect\Gateway\Config\XrplRlusdConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">Hardcastle\LedgerDirect\Gateway\Config\XrplRlusdConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="Hardcastle\LedgerDirect\Gateway\Config\XrplRlusdValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">Hardcastle\LedgerDirect\Gateway\Config\XrplRlusdConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="Hardcastle\LedgerDirect\Gateway\Config\XrplUsdcConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="string">xrpl_usdc_payment</argument>
        </arguments>
    </virtualType>
    <virtualType name="Hardcastle\LedgerDirect\Gateway\Config\XrplUsdcConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">Hardcastle\LedgerDirect\Gateway\Config\XrplUsdcConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="Hardcastle\LedgerDirect\Gateway\Config\XrplUsdcValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">Hardcastle\LedgerDirect\Gateway\Config\XrplUsdcConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>

</config>
