<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <ledger_direct>
                <active>1</active>
                <use_testnet>0</use_testnet>
                <quote_expiry>300</quote_expiry>
                <page_logo_mode>shop</page_logo_mode>
                <page_accent>#1f5eff</page_accent>
                <pending_email_enabled>1</pending_email_enabled>
                <pending_email_identity>sales</pending_email_identity>
                <pending_email_template>payment_ledger_direct_pending_email_template</pending_email_template>
            </ledger_direct>
            <xrp_payment>
                <model>Hardcastle\LedgerDirect\Model\PaymentMethod\XrpFacade</model>
                <title>Pay with XRP | Ledger Direct</title>
                <active>1</active>
                <can_use_checkout>1</can_use_checkout>
                <can_initialize>1</can_initialize>
                <payment_action>order</payment_action>
                <is_offline>1</is_offline>
                <order_status>pending</order_status>
                <settled_status>processing</settled_status>
            </xrp_payment>
            <xrpl_rlusd_payment>
                <model>Hardcastle\LedgerDirect\Model\PaymentMethod\XrplRlusdFacade</model>
                <title>Pay with RLUSD | Ledger Direct</title>
                <active>0</active>
                <can_use_checkout>1</can_use_checkout>
                <can_initialize>1</can_initialize>
                <payment_action>order</payment_action>
                <is_offline>1</is_offline>
                <order_status>pending</order_status>
                <settled_status>processing</settled_status>
            </xrpl_rlusd_payment>
            <xrpl_usdc_payment>
                <model>Hardcastle\LedgerDirect\Model\PaymentMethod\XrplUsdcFacade</model>
                <title>Pay with USDC | Ledger Direct</title>
                <active>0</active>
                <can_use_checkout>1</can_use_checkout>
                <can_initialize>1</can_initialize>
                <payment_action>order</payment_action>
                <is_offline>1</is_offline>
                <order_status>pending</order_status>
                <settled_status>processing</settled_status>
            </xrpl_usdc_payment>
        </payment>
    </default>
</config>
