<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <ledger_direct>
                <active>1</active>
                <use_testnet>0</use_testnet>
            </ledger_direct>
            <xrp_payment>
                <model>Hardcastle\LedgerDirect\Model\PaymentMethod\XrpFacade</model>
                <title>Pay with XRP | Ledger Direct</title>
                <active>1</active>
                <can_use_checkout>1</can_use_checkout>
                <can_initialize>1</can_initialize>
                <is_offline>1</is_offline>
                <order_status>pending</order_status>
                <settled_status>processing</settled_status>
                <processing_status>processing</processing_status>
                <expired_status>canceled</expired_status>
            </xrp_payment>
            <xrpl_rlusd_payment>
                <model>Hardcastle\LedgerDirect\Model\PaymentMethod\XrplRlusdFacade</model>
                <title>Pay with RLUSD | Ledger Direct</title>
                <active>0</active>
                <can_use_checkout>1</can_use_checkout>
                <can_initialize>1</can_initialize>
                <is_offline>1</is_offline>
                <order_status>pending</order_status>
                <settled_status>processing</settled_status>
                <processing_status>processing</processing_status>
                <expired_status>canceled</expired_status>
            </xrpl_rlusd_payment>
            <xrpl_usdc_payment>
                <model>Hardcastle\LedgerDirect\Model\PaymentMethod\XrplUsdcFacade</model>
                <title>Pay with USDC | Ledger Direct</title>
                <active>0</active>
                <can_use_checkout>1</can_use_checkout>
                <can_initialize>1</can_initialize>
                <is_offline>1</is_offline>
                <order_status>pending</order_status>
                <settled_status>processing</settled_status>
                <processing_status>processing</processing_status>
                <expired_status>canceled</expired_status>
            </xrpl_usdc_payment>
        </payment>
    </default>
</config>
