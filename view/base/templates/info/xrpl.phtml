<?php
/**
 * @var \Hardcastle\LedgerDirect\Block\Info $block
 * @var \Magento\Framework\Escaper $escaper
 */
$specificInfo = $block->getSpecificInformation();
$title = $escaper->escapeHtml($block->getMethod()->getTitle());
$explorerUrl = $block->getExplorerUrl();
$transactionLabel = (string) __('Transaction');
?>
<dl class="payment-method">
    <dt class="title"><?= /* @noEscape */ $title ?></dt>
<?php if ($specificInfo): ?>
    <dd class="content">
        <table class="data table">
            <caption class="table-caption"><?= /* @noEscape */ $title ?></caption>
            <?php foreach ($specificInfo as $label => $value): ?>
                <tr>
                    <th scope="row"><?= $escaper->escapeHtml($label) ?></th>
                    <td>
                        <?php if ($label === $transactionLabel && $explorerUrl !== null): ?>
                            <a href="<?= $escaper->escapeUrl($explorerUrl) ?>" target="_blank" rel="noopener"><?= $escaper->escapeHtml((string) $value) ?></a>
                        <?php else: ?>
                            <?= /* @noEscape */ nl2br($escaper->escapeHtml(implode("\n", $block->getValueAsArray($value, true)))) ?>
                        <?php endif; ?>
                    </td>
                </tr>
            <?php endforeach; ?>
        </table>
    </dd>
<?php endif; ?>
</dl>
<?= $block->getChildHtml() ?>
