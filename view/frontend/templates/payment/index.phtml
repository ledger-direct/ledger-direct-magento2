<?php

use Hardcastle\LedgerDirect\Api\Data\XrpPaymentInterface;
use Hardcastle\LedgerDirect\Core\Payment\PaymentStatus;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var XrpPaymentInterface $paymentInfo */
/** @var PaymentStatus $status */

$paymentInfo = $block->getData('payment_info');
$status = $block->getData('payment_status');
$type = $paymentInfo->getType();

$ld_get_svg_html = function (string $icon, array $properties = []): string
{
    if (!ctype_alnum($icon)) {
        die('Forbidden!');
    }

    $defaultProperties = [
        'class' => '',
        'width' => '24',
        'height' => '24',
        'viewBox' => '0 0 24 24',
    ];

    $block = $this->getLayout()->createBlock("Magento\Framework\View\Element\Template");
    $template = $block->setTemplate("Hardcastle_LedgerDirect::icons/{$icon}-svg.phtml");

    foreach ($defaultProperties as $key => $value) {
        if (isset($properties[$key])) {
            $template->setData($key, $properties[$key]);
        } else {
            $template->setData($key, $value);
        }
    }

    return $template->toHtml();
};

$tokenLabels = [
    'xrp-payment' => 'XRP',
    'rlusd-payment' => 'RLUSD',
    'usdc-payment' => 'USDC',
];
$assetLabel = $tokenLabels[$type] ?? 'XRP';
$networkName = $paymentInfo->getNetwork();

/*
 * The five-state payment status (INVARIANTS.md, "Payment status"), rendered server-side:
 * one block per state, the server decides which starts visible, the script only switches
 * them and fills in two numbers from the poll. Every amount comes out of the core as a plain
 * decimal; nothing is rounded here. A settled order never renders this page - the
 * controller redirects it.
 */
$state = $status->state();
$secondsLeft = $status->secondsLeft;
$hasExpiry = (bool) $block->getData('has_expiry');
$amountRequested = $block->escapeHtml($paymentInfo->getAmountRequested());
$amountPaid = $block->escapeHtml((string) $paymentInfo->getAmountPaid());
$shortfall = $block->escapeHtml((string) $paymentInfo->getAmountOutstanding());
$countdown = $secondsLeft === null ? '' : sprintf('%d:%02d', intdiv($secondsLeft, 60), $secondsLeft % 60);

?>

<div class="ld-header">
    <h3>
        <?php $page_title = 'LedgerDirect - pay with ' . $assetLabel . ' directly on XRPL ' . $networkName; ?>
        <?= $block->escapeHtml($page_title) ?>
    </h3>
</div>

<div class="ld-container"
     data-xrp-payment-page="true"
     data-ld-state="<?= $block->escapeHtmlAttr($state) ?>"
     data-ld-poll-url="<?= $block->escapeUrl($block->getData('poll_url')) ?>"
     <?php if ($secondsLeft !== null): ?>data-ld-seconds-left="<?= (int) $secondsLeft ?>"<?php endif; ?>>
    <div class="ld-content">

        <div class="ld-card">

            <div class="ld-card-left">
                <?php if ($type === 'xrp-payment') { ?>
                    <p><?= /* @noEscape */ __('LedgerDirect.paymentPage.sendXrpMessage', $amountRequested) ?></p>
                    <?php /* Read by the wallet integrations; the same string the customer is shown. */ ?>
                    <input id="xrp-amount"
                           type="text"
                           name="xrp-amount"
                           value="<?= $amountRequested ?>"
                           readonly
                           style="display: none;"
                    />
                <?php } else { ?>
                    <p><?= /* @noEscape */ __('LedgerDirect.paymentPage.sendTokenMessage', $amountRequested, $assetLabel) ?></p>
                    <input id="token-amount"
                           type="text"
                           name="token-amount"
                           value="<?= $amountRequested ?>"
                           readonly
                           style="display: none;"
                    />
                    <input id="issuer"
                           type="text"
                           name="issuer"
                           value="<?= $block->escapeHtmlAttr($paymentInfo->getIssuer()) ?>"
                           readonly
                           style="display: none;"
                    />
                    <input id="currency"
                           type="text"
                           name="currency"
                           value="<?= $block->escapeHtmlAttr($paymentInfo->getCurrency()) ?>"
                           readonly
                           style="display: none;"
                    />
                <?php } ?>

                <div class="ld-payment-info">
                    <span>
                        <?= $block->escapeHtml(__('LedgerDirect.paymentPage.destinationAccountLabel')) ?>
                        <?= /* @noEscape */ $ld_get_svg_html('wallet', ['class' => 'inline-svg', 'height' => '16', 'width' => '16', 'viewBox' => '0 0 24 24']) ?>
                    </span>
                    <div class="ld-payment-info-text">
                        <div id="destination-account" class="" data-value="<?= $block->escapeHtmlAttr($paymentInfo->getDestinationAccount()) ?>">
                            <?= $block->escapeHtml($paymentInfo->getDestinationAccount()) ?>
                        </div>
                        <div class="ld-payment-info-functions">
                            <?= /* @noEscape */ $ld_get_svg_html('copy', ['class' => 'action-svg']) ?>
                            <?= /* @noEscape */ $ld_get_svg_html('qr', ['class' => 'action-svg']) ?>
                        </div>
                    </div>
                </div>

                <div class="ld-payment-info">
                    <span>
                        <?= $block->escapeHtml(__('LedgerDirect.paymentPage.destinationTagLabel')) ?>
                        <?= /* @noEscape */ $ld_get_svg_html('tag', ['class' => 'inline-svg', 'height' => '16', 'width' => '16', 'viewBox' => '0 0 24 24']) ?>
                    </span>
                    <div class="ld-payment-info-text">
                        <div id="destination-tag" class="" data-value="<?= (int) $paymentInfo->getDestinationTag() ?>">
                            <?= (int) $paymentInfo->getDestinationTag() ?>
                        </div>
                        <div class="ld-payment-info-functions">
                            <?= /* @noEscape */ $ld_get_svg_html('copy', ['class' => 'action-svg']) ?>
                            <?= /* @noEscape */ $ld_get_svg_html('qr', ['class' => 'action-svg']) ?>
                        </div>
                    </div>
                </div>

                <?php
                /*
                 * Something arrived but the order is not paid. Neutral tone on purpose: the
                 * customer did what their wallet told them; the page explains, it does not
                 * alarm. The markup enclosing the numbers is passed in here, so the
                 * translations carry none of it and the script can find the numbers to update.
                 */
                ?>
                <div class="ld-warning" data-ld-partial <?= $state !== PaymentStatus::PARTIAL ? 'hidden' : '' ?>>
                    <div role="alert" class="alert alert-info">
                        <div class="alert-content-container">
                            <div class="alert-content">
                                <?= /* @noEscape */ __(
                                    'LedgerDirect.paymentPage.partialPaymentNotice',
                                    '<strong data-ld-paid>' . $amountPaid . '</strong> ' . $assetLabel,
                                    '<strong data-ld-shortfall>' . $shortfall . '</strong> ' . $assetLabel
                                ) ?>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="ld-warning" data-ld-wrong-asset <?= $state !== PaymentStatus::WRONG_ASSET ? 'hidden' : '' ?>>
                    <div role="alert" class="alert alert-info">
                        <div class="alert-content-container">
                            <div class="alert-content">
                                <?= /* @noEscape */ __(
                                    'LedgerDirect.paymentPage.wrongTokenNotice',
                                    '<strong data-ld-paid>' . $amountPaid . '</strong>',
                                    '<strong data-ld-shortfall>' . $shortfall . '</strong>',
                                    $assetLabel
                                ) ?>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="ld-warning">
                    <div role="alert" class="alert alert-warning alert-has-icon">
                        <div class="alert-content-container">
                            <div class="alert-content">
                                <?= $block->escapeHtml(__('LedgerDirect.paymentPage.destinationTagWarning', $assetLabel)) ?>
                            </div>
                        </div>
                    </div>
                </div>

                <?php if ($hasExpiry): ?>
                    <?php
                    /*
                     * Both blocks are always rendered so the countdown can swap them without a
                     * reload; the server decides which one starts visible. Neither shows while a
                     * payment has arrived: the state blocks above take over, and a refresh would
                     * re-quote an order that is already partly paid.
                     */
                    ?>
                    <p class="ld-quote-validity" data-ld-live <?= $state !== PaymentStatus::WAITING ? 'hidden' : '' ?>>
                        <?= $block->escapeHtml(__('LedgerDirect.paymentPage.quoteValidFor')) ?>
                        <strong data-ld-countdown><?= $block->escapeHtml($countdown) ?></strong>
                    </p>

                    <div class="ld-warning" data-ld-expired <?= $state !== PaymentStatus::EXPIRED ? 'hidden' : '' ?>>
                        <div role="alert" class="alert alert-warning">
                            <div class="alert-content-container">
                                <div class="alert-content">
                                    <p><?= $block->escapeHtml(__('LedgerDirect.paymentPage.quoteExpired')) ?></p>
                                    <p><?= $block->escapeHtml(__('LedgerDirect.paymentPage.quoteExpiredDoNotResend')) ?></p>
                                    <form method="post" action="<?= $block->escapeUrl($block->getData('refresh_url')) ?>">
                                        <input type="hidden" name="form_key" value="<?= $block->escapeHtmlAttr($block->getData('form_key')) ?>">
                                        <input type="hidden" name="id" value="<?= (int) $paymentInfo->getOrderId() ?>">
                                        <input type="hidden" name="key" value="<?= $block->escapeHtmlAttr($block->getData('access_key')) ?>">
                                        <button type="submit" class="ld-refresh-quote">
                                            <?= $block->escapeHtml(__('LedgerDirect.paymentPage.refreshQuoteButton')) ?>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                <?php endif; ?>

                <div class="ld-sync">
                    <!-- Wallet buttons -->
                    <!--
                    <button id="gem-wallet-button" class="wallet-disabled">G</button>
                    <button id="crossmark-wallet-button" class="wallet-disabled">C</button>
                    <button id="xumm-wallet-button" class="wallet-disabled">X</button>
                    -->
                    <?php /* The manual path, and the only one a browser without JavaScript has. */ ?>
                    <button id="check-payment-button" data-order-id="<?= $block->escapeHtmlAttr($paymentInfo->getOrderNumber()) ?>">
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"
                              style="display:none"></span>
                        <?= $block->escapeHtml(__('LedgerDirect.paymentPage.checkPaymentButton')) ?>
                    </button>
                </div>

            </div>

            <div class="ld-card-right">
                <div class="ld-sum"><?= $block->escapeHtml((string) $paymentInfo->getPrice()) ?> <?= $block->escapeHtml($paymentInfo->getCurrencySymbol()) ?></div>
                <span><?= $block->escapeHtml(__('LedgerDirect.paymentPage.orderNumber')) ?>: <?= $block->escapeHtml($paymentInfo->getOrderNumber()) ?></span><br/>
                <span><?= $block->escapeHtml(__('LedgerDirect.paymentPage.total')) ?>: <?= $block->escapeHtml((string) $paymentInfo->getPrice()) ?> <?= $block->escapeHtml($paymentInfo->getCurrencyCode()) ?></span><br/>
                <span><?= $block->escapeHtml(__('LedgerDirect.paymentPage.total')) ?>: <?= $amountRequested ?> <?= $block->escapeHtml($assetLabel) ?></span><br/>
                <span><?= $block->escapeHtml(__('LedgerDirect.paymentPage.exchangeRate')) ?>: <?= $block->escapeHtml((string) $paymentInfo->getExchangeRate()) ?> <?= $block->escapeHtml($assetLabel) ?> / <?= $block->escapeHtml($paymentInfo->getCurrencyCode()) ?></span><br/>
                <span><?= $block->escapeHtml(__('LedgerDirect.paymentPage.network')) ?>: <?= $block->escapeHtml($networkName) ?></span><br/>
            </div>

        </div>

        <div class="ld-footer">
            <a href="<?= $block->escapeUrl($block->getUrl('checkout')) ?>" class="ld-back-to-cart">
                <?= $block->escapeHtml(__('LedgerDirect.paymentPage.backButton')) ?>
            </a>
        </div>

    </div>
</div>

<script type="text/x-magento-init">
    {
        "*": {
            "Hardcastle_LedgerDirect/js/main": {
            "deps": [
                "jquery",
                "Hardcastle_LedgerDirect/js/jquery-qrcode.min"
            ]
        }
        }
    }
</script>
